        f"Valor médio de a: {media_a:.6f} Å (Desvio-padrão: {desvio:.6f} Å)\n"
        f"Valor médio de b: {media_b:.6f} Å (Desvio-padrão: {desvio_b:.6f} Å)\n"
        f"Valor médio de c: {media_c:.6f} Å (Desvio-padrão: {desvio_c:.6f} Å)\n"
        f"Valor médio de beta: {angulo_beta:.6f}° (Desvio-padrão: {angulo_beta_desvio:.6f}°)\n"
        f"Fixed Angles: alpha = gamma = 90.0°\n"
        f"Valor médio do volume: {media_volume:.6f} Å³ (Desvio-padrão: {desvio_volume:.6f} Å³)\n"
    )
    exportar_relatorio_resultados("Monoclinico", conteudo_txt)

def triclinica():
    a_list = []
    b_list = []
    c_list = []
    alpha_list = []
    beta_list = []
    gamma_list = []
    lista_volumes_tricli = []  # Nome exclusivo para NUNCA conflitar com variáveis de ponto flutuante
    p = 6
    
    conta = 0
    media_a = 0.0
    media_b = 0.0
    media_c = 0.0
    media_alpha = 0.0
    media_beta = 0.0
    media_gamma = 0.0
    media_volume = 0.0  # Inicialização da média do volume

    # 1. ABERTURA VISUAL DINÂMICA GLOBAL
    dados_csv, separador = selecionar_arquivo_csv()
    if dados_csv is None:
        return

    # ==================================================================
    # DECLARAÇÃO ANTECIPADA DAS VARIÁVEIS (Garante Escopo Correto)
    # ==================================================================
    h = []
    k = []
    l = []
    picos = []
    # ==================================================================

    try:
        # 2. SELEÇÃO DE MODOS: AUTOMÁTICO POR INTENSIDADE OU MANUAL POR HKL
        print(f"\nO arquivo carregou um total de {dados_csv.shape[0]} picos válidos.")
        print("Opções de Filtragem:\n [1] Selecionar automaticamente os picos mais intensos\n [2] Selecionar manualmente por índices de Miller (h k l)")
        
        while True:
            try:
                modo_input = input("Escolha o modo de filtragem: ").strip()
                if "python.exe" in modo_input or "&" in modo_input or not modo_input:
                    continue
                modo = int(modo_input)
                if modo in (1, 2):
                    break
                else:
                    print("Opção inválida. Por favor, digite 1 ou 2.")
            except ValueError:
                print("[Aviso] Entrada inválida. Digite apenas o número 1 ou 2.")
                continue
        
        if modo == 1:
            # --- MODO AUTOMÁTICO ---
            while True:
                try:
                    pergunta_picos = input("Quantos picos mais intensos você deseja utilizar para o cálculo? ").strip()
                    if "python.exe" in pergunta_picos or not pergunta_picos:
                        continue
                    num_picos = int(pergunta_picos)
                    if num_picos > 0:
                        break
                    else:
                        print("Por favor, digite um número maior que zero.")
                except ValueError:
                    print("[Aviso] Digite apenas um número inteiro válido.")
                    continue

            if num_picos > dados_csv.shape[0]:
                num_picos = dados_csv.shape[0]
            indices_ordenados = np.argsort(dados_csv[:, 6])[::-1]
            dados_filtrados = dados_csv[indices_ordenados[:num_picos]]
            
        elif modo == 2:
            # --- MODO SELEÇÃO MANUAL ---
            print("\nPicos disponíveis no arquivo:")
            print("Índice |   2-Theta   |   h k l   |  Intensidade")
            for idx in range(dados_csv.shape[0]):
                print(f"  [{idx}]  |   {dados_csv[idx, 3]:.2f}°   |  {int(dados_csv[idx, 0])} {int(dados_csv[idx, 1])} {int(dados_csv[idx, 2])}  |  {dados_csv[idx, 6]}")
                
            picos_escolhidos_indices = []
            min_requisito = 6  # Requisito mínimo para o triclínico é 6 picos
            print(f"\nDigite o terno h k l desejado separado por espaços (Exemplo: 0 0 1). Digite 'fim' para encerrar.")
            
            while True:
                entrada = input(f"Selecione um plano h k l (Mínimo restante: {max(0, min_requisito - len(picos_escolhidos_indices))}): ").strip()
                if entrada.lower() == 'fim':
                    if len(picos_escolhidos_indices) < min_requisito:
                        print(f"Erro: Você precisa selecionar pelo menos {min_requisito} picos para resolver este sistema.")
                        continue
                    break
                
                try:
                    h_busca, k_busca, l_busca = map(int, entrada.split())
                    match = np.where((dados_csv[:, 0] == h_busca) & (dados_csv[:, 1] == k_busca) & (dados_csv[:, 2] == l_busca))[0]
                    
                    if len(match) > 0:
                        idx_encontrado = match[0]
                        if idx_encontrado not in picos_escolhidos_indices:
                            picos_escolhidos_indices.append(idx_encontrado)
                            print(f"-> Plano ({h_busca} {k_busca} {l_busca}) adicionado com sucesso! (2-Theta: {dados_csv[idx_encontrado, 3]}°)")
                        else:
                            print("[Aviso] Esse plano já foi adicionado anteriormente.")
                    else:
                        print("[Erro] Plano h k l não encontrado no arquivo CSV. Tente novamente.")
                except ValueError:
                    print("[Erro] Formato inválido. Digite 3 números inteiros separados por espaço (Ex: 0 1 2).")
            
            dados_filtrados = dados_csv[picos_escolhidos_indices]
            
        else:
            indices_ordenados = np.argsort(dados_csv[:, 6])[::-1]
            dados_filtrados = dados_csv[indices_ordenados[:6]]

        # Reordena os picos selecionados por ângulo 2-Theta
        dados_filtrados = dados_filtrados[np.argsort(dados_filtrados[:, 3])]
        
        # Preenche com .extend() as listas externas declaradas no topo da função
        h.extend(dados_filtrados[:, 0].astype(int).tolist())
        k.extend(dados_filtrados[:, 1].astype(int).tolist())
        l.extend(dados_filtrados[:, 2].astype(int).tolist())
        picos.extend(dados_filtrados[:, 3].tolist())
        
        print(f"\n[Sucesso] {len(picos)} picos finais integrados para o cálculo combinatório.")

    except Exception as erro:
        print(f"Erro ao carregar ou processar os dados: {erro}")
        return

    # 3. EXECUÇÃO DO SEU MOTOR COMBINATÓRIO TRICLÍNICO
    nome_estrutura, distancia, comp_de_onda = angulosTeste(picos)

    ctCombina = 1
    tamanhoPicos = len(picos)
    indices = list(range(tamanhoPicos))
    combinacoes_indices = list(itertools.combinations(indices, p))  # Combina de 6 em 6
    
    print(f"Iniciando o processamento combinatório de {len(combinacoes_indices)} matrizes triclínicas...")

    for combinacao in combinacoes_indices:
        ang = [combinacao[i] for i in range(6)]
        
        # Coeficientes numéricos rápidos para o filtro de determinante 6x6
        v1, v2, v3, v4, v5, v6 = h[ang[0]]**2, k[ang[0]]**2, l[ang[0]]**2, h[ang[0]]*k[ang[0]], h[ang[0]]*l[ang[0]], k[ang[0]]*l[ang[0]]
        v1a, v2a, v3a, v4a, v5a, v6a = h[ang[1]]**2, k[ang[1]]**2, l[ang[1]]**2, h[ang[1]]*k[ang[1]], h[ang[1]]*l[ang[1]], k[ang[1]]*l[ang[1]]
        v1b, v2b, v3b, v4b, v5b, v6b = h[ang[2]]**2, k[ang[2]]**2, l[ang[2]]**2, h[ang[2]]*k[ang[2]], h[ang[2]]*l[ang[2]], k[ang[2]]*l[ang[2]]
        v1c, v2c, v3c, v4c, v5c, v6c = h[ang[3]]**2, k[ang[3]]**2, l[ang[3]]**2, h[ang[3]]*k[ang[3]], h[ang[3]]*l[ang[3]], k[ang[3]]*l[ang[3]]
        v1d, v2d, v3d, v4d, v5d, v6d = h[ang[4]]**2, k[ang[4]]**2, l[ang[4]]**2, h[ang[4]]*k[ang[4]], h[ang[4]]*l[ang[4]], k[ang[4]]*l[ang[4]]
        v1e, v2e, v3e, v4e, v5e, v6e = h[ang[5]]**2, k[ang[5]]**2, l[ang[5]]**2, h[ang[5]]*k[ang[5]], h[ang[5]]*l[ang[5]], k[ang[5]]*l[ang[5]]

        # --- FILTRO CRISTALOGRÁFICO DE INDEPENDÊNCIA LINEAR 6x6 ---
        M_teste = np.array([
            [v1, v2, v3, v4, v5, v6],
            [v1a, v2a, v3a, v4a, v5a, v6a],
            [v1b, v2b, v3b, v4b, v5b, v6b],
            [v1c, v2c, v3c, v4c, v5c, v6c],
            [v1d, v2d, v3d, v4d, v5d, v6d],
            [v1e, v2e, v3e, v4e, v5e, v6e]
        ])
        if np.abs(np.linalg.det(M_teste)) < 1e-4:
            continue  # Descarta planos linearmente dependentes antes do SymPy
        # ---------------------------------------------------------

        # Definição das variáveis simbólicas lineares do tensor recíproco
        x1, x2, x3, x4, x5, x6 = sp.symbols('x1 x2 x3 x4 x5 x6')
        
        eqs = []
        for idx in ang:
            eq = sp.Eq((h[idx]**2)*x1 + (k[idx]**2)*x2 + (l[idx]**2)*x3 + (h[idx]*k[idx])*x4 + (h[idx]*l[idx])*x5 + (k[idx]*l[idx])*x6, 1 / (distancia[idx]**2))
            eqs.append(eq)

        solution = sp.solve(eqs, (x1, x2, x3, x4, x5, x6))
        
        if len(solution) != 0 and (x1 in solution):
            try:
                q11 = float(solution[x1])
                q22 = float(solution[x2])
                q33 = float(solution[x3])
                q12 = float(solution[x4]) / 2.0
                q13 = float(solution[x5]) / 2.0
                q23 = float(solution[x6]) / 2.0
                
                G_star = np.array([[q11, q12, q13], [q12, q22, q23], [q13, q23, q33]])
                
                if np.abs(np.linalg.det(G_star)) < 1e-6:
                    continue
                G = np.linalg.inv(G_star)
                
                if G[0,0] <= 0 or G[1,1] <= 0 or G[2,2] <= 0:
                    continue
                    
                val_a = np.sqrt(G[0,0])
                val_b = np.sqrt(G[1,1])
                val_c = np.sqrt(G[2,2])
                
                cos_alpha = G[1,2] / (val_b * val_c)
                cos_beta  = G[0,2] / (val_a * val_c)
                cos_gamma = G[0,1] / (val_a * val_b)
                
                if np.abs(cos_alpha) >= 1.0 or np.abs(cos_beta) >= 1.0 or np.abs(cos_gamma) >= 1.0:
                    continue
                    
                val_alpha = math.degrees(math.acos(cos_alpha))
                val_beta  = math.degrees(math.acos(cos_beta))
                val_gamma = math.degrees(math.acos(cos_gamma))
                
                # --- CÁLCULO DO VOLUME TRICLÍNICO PARA CADA COMBINAÇÃO BEM-SUCEDIDA ---
                rad_al = math.radians(val_alpha)
                rad_be = math.radians(val_beta)
                rad_ga = math.radians(val_gamma)

                fator_vol = math.sqrt(1.0 - math.cos(rad_al)**2 - math.cos(rad_be)**2 - math.cos(rad_ga)**2 + 2.0 * math.cos(rad_al) * math.cos(rad_be) * math.cos(rad_ga))
                val_volume = val_a * val_b * val_c * fator_vol
                lista_volumes_tricli.append(val_volume)
                # -----------------------------------------------------------------------
                a_list.append(val_a)
                b_list.append(val_b)
                c_list.append(val_c)
                alpha_list.append(val_alpha)
                beta_list.append(val_beta)
                gamma_list.append(val_gamma)
                media_a += val_a
                media_b += val_b
                media_c += val_c
                media_alpha += val_alpha
                media_beta += val_beta
                media_gamma += val_gamma
                media_volume += val_volume
                conta += 1
                print(f"-> Solução triclínica {conta} calculada com sucesso!")
            except (IndexError, TypeError, KeyError):
                continue

    # VALIDAÇÃO DE CONVERGÊNCIA CONTRA DIVISION BY ZERO
    if conta == 0:
        print("\n[Aviso] Nenhuma combinação triclínica conseguiu convergir para uma solução válida.")
        print("Dica: No modo automático, selecione de 10 a 14 picos para dar mais opções de planos hkl lineares.")
        return

    # Cálculo estatístico das médias finais das soluções estáveis
    media_a /= conta
    media_b /= conta
    media_c /= conta
    media_alpha /= conta
    media_beta /= conta
    media_gamma /= conta
    media_volume /= conta
    print("\nTriclínico - Resultados Finais")
    print("Ângulo |   2-Theta   |   distância interplanar   |   h k l   ")
    for i in range(tamanhoPicos):
        print("  ", i + 1, "     ", picos[i], "          ", '{:.{}f}'.format(round((distancia[i]), 6), 6),
              "    ", "             ", h[i], k[i], l[i])
    print("\n=== VALORES MÉDIOS E DESVIOS CALCULADOS ===")
    print("Valor médio de a:  ", '{:.{}f}'.format(round(media_a, 6), 6), " angstons")
    print("Desvio-padrão de a: ", '{:.{}f}'.format(round(np.std(a_list), 6), 6), " angstons")
    print("Valor médio de b:  ", '{:.{}f}'.format(round(media_b, 6), 6), " angstons")
    print("Desvio-padrão de b: ", '{:.{}f}'.format(round(np.std(b_list), 6), 6), " angstons")
    print("Valor médio de c:  ", '{:.{}f}'.format(round(media_c, 6), 6), " angstons")
    print("Desvio-padrão de c: ", '{:.{}f}'.format(round(np.std(c_list), 6), 6), " angstons")
    print("Valor médio de alpha: ", '{:.{}f}'.format(round(media_alpha, 4), 4), " graus")
    print("Desvio-padrão de alpha: ", '{:.{}f}'.format(round(np.std(alpha_list), 4), 4), " graus")
    print("Valor médio de beta: ", '{:.{}f}'.format(round(media_beta, 4), 4), " graus")
    print("Desvio-padrão de beta: ", '{:.{}f}'.format(round(np.std(beta_list), 4), 4), " graus")
    print("Valor médio de gamma: ", '{:.{}f}'.format(round(media_gamma, 4), 4), " graus")
    print("Desvio-padrão de gamma: ", '{:.{}f}'.format(round(np.std(gamma_list), 4), 4), " graus")
    print("Valor médio do volume:  ", '{:.{}f}'.format(round(media_volume), 6), " angstons³")
    desvio_volume = np.std(lista_volumes_tricli)
    print("Desvio-padrão de volume: ", '{:.{}f}'.format(round(desvio_volume), 6), " angstons³")

    # Variáveis locais explícitas para evitar alertas de escopo/variáveis não definidas
    valor_media_a = media_a
    valor_media_b = media_b
    valor_media_c = media_c
    valor_media_alpha = media_alpha
    valor_media_beta = media_beta
    valor_media_gamma = media_gamma
    valor_media_volume = media_volume
    desvio_a = float(np.std(a_list))
    desvio_b = float(np.std(b_list))
    desvio_c = float(np.std(c_list))
    desvio_alpha = float(np.std(alpha_list))
    desvio_beta = float(np.std(beta_list))
    desvio_gamma = float(np.std(gamma_list))

    conteudo_txt = (
        f"=== RELATÓRIO DE PARÂMETROS DE REDE - SISTEMA TRICLÍNICO ===\n"
        f"Eixos Diretos (Médias e Dispersões):\n"
        f"  a = {valor_media_a:.6f} ± {desvio_a:.6f} Å\n"
        f"  b = {valor_media_b:.6f} ± {desvio_b:.6f} Å\n"
        f"  c = {valor_media_c:.6f} ± {desvio_c:.6f} Å\n"
        f"Ângulos Interaxiais:\n"
        f"  alpha = {valor_media_alpha:.4f}° ± {desvio_alpha:.4f}°\n"
        f"  beta  = {valor_media_beta:.4f}° ± {desvio_beta:.4f}°\n"
        f"  gamma = {valor_media_gamma:.4f}° ± {desvio_gamma:.4f}°\n"
        f"Valor médio do volume: {valor_media_volume:.6f} Å³ (Desvio-padrão: {desvio_volume:.6f} Å³)\n"
    )
    exportar_relatorio_resultados("Triclinico", conteudo_txt)

