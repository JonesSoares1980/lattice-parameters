    total_peaks = len(peaks)
    indices = list(range(total_peaks))
    combinations_indices = list(itertools.combinations(indices, 2))
    for combination in combinations_indices:
        angle1 = combination[0]
        angle2 = combination[1]
        print(f"Combination {ct_comb}: {peaks[angle1]} and {peaks[angle2]}")
