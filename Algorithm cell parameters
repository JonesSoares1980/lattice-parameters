        x, y = sp.symbols('x y')

        equation1 = sp.Eq((((h[angle1]) ** 2 + (k[angle1] ** 2)) / (x ** 2)) + ((l[angle1] ** 2) / (y ** 2)), 1 / (d_values[angle1]) ** 2)
        equation2 = sp.Eq((((h[angle2]) ** 2 + (k[angle2] ** 2)) / (x ** 2)) + ((l[angle2] ** 2) / (y ** 2)), 1 / (d_values[angle2]) ** 2)

