def selecionar_arquivo_csv():
    """
    Abre uma janela visual do Windows para o usuário selecionar qualquer arquivo .csv.
    Retorna a matriz de dados carregada via numpy e as linhas processadas puras.
    """
    # Inicializa o Tkinter de forma oculta (sem abrir uma janela vazia atrás)
    root = tk.Tk()
    root.withdraw()
    root.attributes("-topmost", True)  # Força a janela a aparecer na frente de tudo
    
    print("\n[Aviso] Uma janela visual foi aberta. Selecione o arquivo .csv da estrutura desejada...")
    caminho_arquivo = filedialog.askopenfilename(
        title="Selecionar arquivo CSV de Difração",
        filetypes=[("Arquivos CSV", "*.csv"), ("Arquivos de Texto", "*.txt"), ("Todos os arquivos", "*.*")]
    )
    
    if not caminho_arquivo:
        print("[Erro] Nenhum arquivo foi selecionado. Encerrando execução.")
        return None, None
        
    try:
        # Identifica o delimitador automaticamente (; ou ,)
        with open(caminho_arquivo, 'r', encoding='utf-8') as f:
            linhas = f.readlines()
        separador = ';' if ';' in linhas[0] else ','
        
        # Tratamento de vírgula decimal (padrão brasileiro) se houver
        linhas_processadas = [linhas[0]]
        for linha in linhas[1:]:
            if linha.strip():
                if separador == ';':
                    linha = linha.replace(',', '.')
                linhas_processadas.append(linha)
                
        # Carrega a matriz de dados via numpy
        dados_csv = np.genfromtxt(linhas_processadas, delimiter=separador, skip_header=1)
        
        # Limpeza preventiva contra NaNs e garante 2-Theta (coluna 3) > 0
        dados_csv = dados_csv[~np.isnan(dados_csv[:, 3])]
        dados_csv = dados_csv[dados_csv[:, 3] > 0]
        
        print(f"-> Arquivo carregado com sucesso: {os.path.basename(caminho_arquivo)}")
        return dados_csv, separador
        
    except Exception as e:
        print(f"[Erro] Falha ao processar o arquivo selecionado: {e}")
        return None, None

def exportar_relatorio_resultados(nome_sistema, texto_conteudo):
    """
    Abre uma janela visual para o usuário salvar os resultados do Terminal
    em um arquivo de texto (.txt) em qualquer diretório do computador.
    """
    root = tk.Tk()
    root.withdraw()
    root.attributes("-topmost", True)
    
    print(f"\n[Aviso] Abrindo janela para salvar o relatório do Sistema {nome_sistema}...")
    caminho_salvamento = filedialog.asksaveasfilename(
        title=f"Salvar Relatório - Sistema {nome_sistema}",
        initialfile=f"Relatorio_Lattice_{nome_sistema}.txt",
        filetypes=[("Arquivos de Texto", "*.txt"), ("Todos os arquivos", "*.*")],
        defaultextension=".txt"
    )
    
    if caminho_salvamento:
        try:
            with open(caminho_salvamento, 'w', encoding='utf-8') as f:
                f.write(texto_conteudo)
            print(f"✅ [Sucesso] Relatório exportado com sucesso em:\n-> {caminho_salvamento}\n")
        except Exception as e:
            print(f"[Erro] Falha ao gravar o arquivo de relatório: {e}")
    else:
        print("[Aviso] Exportação cancelada pelo usuário. Os dados ficaram registrados apenas no Terminal.")

