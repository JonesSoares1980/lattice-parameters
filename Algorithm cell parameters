def select_csv_file():
    """
    Opens a graphical file dialog window for the user to select any .csv file.
    Returns the data matrix loaded via numpy and the detected delimiter.
    """
    root = tk.Tk()
    root.withdraw()
    root.attributes("-topmost", True)
    
    print("\n[Notice] A file dialog window has opened. Please select the diffraction .csv file...")
    file_path = filedialog.askopenfilename(
        title="Select Diffraction CSV File",
        filetypes=[("CSV Files", "*.csv"), ("Text Files", "*.txt"), ("All Files", "*.*")]
    )
    
    if not file_path:
        print("[Error] No file was selected. Aborting execution.")
        return None, None
        
    try:
        with open(file_path, 'r', encoding='utf-8') as f:
            linhas = f.readlines()
        delimiter = ';' if ';' in linhas[0] else ','
        
        processed_lines = [linhas[0]]
        for line in lines[1:]:
            if line.strip():
                if delimiter == ';':
                    line = line.replace(',', '.')
                processed_lines.append(line)
                
        csv_data = np.genfromtxt(processed_lines, delimiter=delimiter, skip_header=1)
        csv_data = csv_data[~np.isnan(csv_data[:, 3])]
        csv_data = csv_data[csv_data[:, 3] > 0]
        
        print(f"-> File loaded successfully: {os.path.basename(file_path)}")
        return csv_data, delimiter
        
    except Exception as e:
        print(f"[Error] Failed to process the selected file: {e}")
        return None, None

def export_results_report(system_name, report_content):
    """
    Opens a file dialog for the user to save the terminal results
    as a text file (.txt) in any directory on the computer.
    """
    root = tk.Tk()
    root.withdraw()
    root.attributes("-topmost", True)
    
    print(f"\n[Notice] Opening window to save the {system_name} system report...")
    save_path = filedialog.asksaveasfilename(
        title=f"Save Report - {system_name} System",
        initialfile=f"Lattice_Report_{system_name}.txt",
        filetypes=[("Text Files", "*.txt"), ("All Files", "*.*")],
        defaultextension=".txt"
    )
    
    if save_path:
        try:
            with open(save_path, 'w', encoding='utf-8') as f:
                f.write(report_content)
            print(f"✅ [Success] Report successfully exported to:\n-> {save_path}\n")
        except Exception as e:
            print(f"[Error] Failed to write the report file: {e}")
    else:
        print("[Notice] Export canceled by the user. Data remains registered in the Terminal only.")

def print_angles_results(structure_name, peaks, d_values, wavelength, h, k, l, a_values, mean_a):
    print(structure_name)
    print("Peak |   2-Theta   |   Interplanar Spacing (d)   |    h k l   |    a    ")
    index = 0
    for peak in peaks:
        print("  ", index + 1, "     ", peak, "          ", '{:.{}f}'.format(round((d_values[index]), 6), 6),
              "    ", "             ", h[index], k[index], l[index], "    ", '{:.{}f}'.format(round(a_values[index], 6), 6))
        index += 1
    print("Mean value of a:  ", '{:.{}f}'.format(round((mean_a), 6), 6), " Angstroms")
    std_dev = np.std(a_values)
    print("Standard deviation of a: ", '{:.{}f}'.format(round((std_dev), 6), 6), " Angstroms")

def get_indexed_distances(peaks):
    d_values = []
    wavelength = float(input("Wavelength (Lambda): "))
    for i in range(len(peaks)):
        peak_idx = i
        value = peaks[peak_idx]
        d_values.append(float(wavelength / (2.0 * math.sin(math.radians(value / 2.0)))))
    return "Structure", d_values, wavelength

def cubic():
    a = []
    mean_val = float(0)

    csv_data, delimiter = select_csv_file()
    if csv_data is None:
        return

    h = csv_data[:, 0].astype(int).tolist()
    k = csv_data[:, 1].astype(int).tolist()
    l = csv_data[:, 2].astype(int).tolist()
    peaks = csv_data[:, 3].tolist()

    conta = 0
    structure_name, d_values, wavelength = get_indexed_distances(peaks)
    for distance in d_values:
        a.append(distance * (math.sqrt((h[conta] ** 2) + (k[conta] ** 2) + (l[conta] ** 2))))
        mean_val = mean_val + a[conta]
        conta += 1

    mean_val = mean_val / conta
    print(mean_val)
    std_dev = np.std(a)
    print("Standard deviation of a: ", '{:.{}f}'.format(round((std_dev), 6), 6), " Angstroms")
    print_angles_results(structure_name, peaks, d_values, wavelength, h, k, l, a, mean_val)
    print("alpha = beta = gamma = 90 degrees")

    report_content = (
        f"=== LATTICE PARAMETERS REPORT - CUBIC SYSTEM ===\n"
        f"Mean value of a: {mean_val:.6f} Å\n"
        f"Standard deviation of a: {std_dev:.6f} Å\n"
        f"Interaxial Angles: alpha = beta = gamma = 90.0°\n"
    )
    export_results_report("Cubic", report_content)

def tetragonal():
