        # Definindo as equações
        equation1 = sp.Eq((4 / 3) * (((h[angulo1]) ** 2 + (h[angulo1] * k[angulo1]) + (k[angulo1] ** 2)) / (x ** 2)) + (
                    (l[angulo1] ** 2) / (y ** 2)),
