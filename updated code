def angulosTeste(picos):
    # n = int(input("Digite o número de picos: "))
    distancia = []
    comp_de_onda = float(input("Comprimento de onda: "))
    for i in range(len(picos)):
        angulo = i
        valor = picos[angulo]
        distancia.append(float(comp_de_onda / (2.0 * math.sin(math.radians(valor / 2.0)))))

    return "Estrutura", distancia, comp_de_onda


def cubica(densidade, massa_molar):  # <-- Atualize para receber as duas variáveis aqui!
    a = []
    lista_volumes_cubo = []
    media = float(0)
    media_volume = float(0)

    dados_csv, separador = selecionar_arquivo_csv()
    if dados_csv is None:
        return

    # Fatiamento automático de todas as linhas do arquivo
    h = dados_csv[:, 0].astype(int).tolist()
    k = dados_csv[:, 1].astype(int).tolist()
    l = dados_csv[:, 2].astype(int).tolist()
    picos = dados_csv[:, 3].tolist()

    conta = 0
    nome_estrutura, distancias, comp_de_onda = angulosTeste(picos)
    
    for distancia in distancias:
        val_a = distancia * (math.sqrt((h[conta] ** 2) + (k[conta] ** 2) + (l[conta] ** 2)))
        a.append(val_a)
        
        val_volume = val_a ** 3
        lista_volumes_cubo.append(val_volume)
        
        media = media + val_a
        media_volume = media_volume + val_volume
        conta += 1

    if conta == 0:
        print("[Erro] Nenhum pico foi processado.")
        return
        
    media = media / conta
    media_volume = media_volume / conta

    # --- O BLOCO ANTIGO DE PERGUNTAS FOI REMOVIDO DAQUI ---
    # O código agora usa direto a densidade e massa_molar que vieram do menu principal!
    N_A = 6.02214e23  # Constante de Avogadro
    volume_cm3 = media_volume * 1e-24  # Converte Å³ para cm³
    Z_exato = (densidade * volume_cm3 * N_A) / massa_molar
    Z_real = round(Z_exato)
    # ====================================================

    print("\n=== RESULTADOS NO TERMINAL ===")
    print(f"Média de a: {media:.6f} Å")
    print(f"Média do Volume: {media_volume:.6f} Å³")
    
    desvio = np.std(a)
    desvio_volume = np.std(lista_volumes_cubo)
    
    print("Desvio-padrão de a: ", '{:.{}f}'.format(round((desvio), 6), 6), " angstrons")
    print("Desvio-padrão de volume: ", '{:.{}f}'.format(round((desvio_volume), 6), 6), " angstrons³")

    print(f"Número de unidades fórmula calculado (Z exato): {Z_exato:.4f}")
    print(f"Número inteiro de unidades fórmula na célula (Z): {Z_real}")
    
    resultado_angulos(nome_estrutura, picos, distancias, comp_de_onda, h, k, l, a, media)
    print("angulo_alfa = angulo_beta = angulo_gama = 90 graus")

    conteudo_txt = (
        f"=== RELATÓRIO DE PARÂMETROS DE REDE - SISTEMA CÚBICO ===\n"
        f"Data do Cálculo: 2026\n"
        f"Valor médio de a: {media:.6f} Å (Desvio-padrão: {desvio:.6f} Å)\n"
        f"Valor médio do volume: {media_volume:.6f} Å³ (Desvio-padrão: {desvio_volume:.6f} Å³)\n"
        f"Número de unidades fórmula por célula (Z): {Z_real} (Valor exato: {Z_exato:.4f})\n"
